[Unit]
Description=OpenTorque PBS Scheduler
After=network-online.target
Wants=network-online.target
After=pbs_server.service
PartOf=pbs_server.service

[Service]
Type=simple
# Cloud-bursting provider identity (only needed for the Azure CRP; the
# scheduler reads PBS_PG_DSN from ha.env only if we add it here).
EnvironmentFile=-/etc/opentorque/ha.env
ExecStart=/usr/local/sbin/pbs_sched -D -p /var/spool/torque
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
